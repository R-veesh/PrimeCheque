<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PrimeCheque.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrimeCheque"
    xmlns:views="using:PrimeCheque.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PrimeCheque — Standalone Sri Lankan Cheque Writing &amp; Printing System">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="TitleBarIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (Draggable Region) -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Height="44" Background="Transparent" Canvas.ZIndex="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="12">
                <FontIcon Glyph="&#xE8D4;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="PrimeCheque" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Custom Title Bar Interactive Elements (Overlayed) -->
        <Grid Grid.Row="0" Height="44" Canvas.ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Right: Toolbar Icons -->
            <!-- The margin will be dynamically updated in code-behind to account for system caption buttons -->
            <StackPanel x:Name="TitleBarRightControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" Margin="0,0,160,0">
                <Button Style="{StaticResource TitleBarIconButtonStyle}" Content="&#xE713;" ToolTipService.ToolTip="Settings" Click="TitleBarSettings_Click" />
                <Button Style="{StaticResource TitleBarIconButtonStyle}" Content="&#xE706;" ToolTipService.ToolTip="Toggle Theme" Click="TitleBarThemeToggle_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Login overlay (shown initially) -->
            <Frame x:Name="LoginFrame" />

            <!-- Main app shell (shown after login) -->
        <NavigationView x:Name="NavView" Visibility="Collapsed" SelectionChanged="NavView_SelectionChanged" Loaded="NavView_Loaded" IsBackButtonVisible="Auto" BackRequested="NavView_BackRequested" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" x:Name="NavDashboard" />
                <NavigationViewItem Content="New Cheque" Tag="NewCheque" Icon="Edit" x:Name="NavNewCheque" />
                <NavigationViewItem Content="Cheques Register" Tag="Cheques" Icon="List" x:Name="NavCheques" />
                <NavigationViewItem Content="Cheque Books" Tag="ChequeBooks" Icon="Library" x:Name="NavChequeBooks" />
                <NavigationViewItem Content="Payees" Tag="Payees" Icon="Contact" x:Name="NavPayees" />
                <NavigationViewItem Content="Batch Import" Tag="BatchImport" Icon="Download" x:Name="NavBatchImport" />
                <NavigationViewItem Content="Reports" Tag="Reports" Icon="ReportHacked" x:Name="NavReports" />
                <NavigationViewItem Content="Audit Log" Tag="AuditLog" Icon="Important" x:Name="NavAuditLog" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Companies" Tag="Companies" Icon="AllApps" x:Name="NavCompanies" />
                <NavigationViewItem Content="Banks" Tag="Banks" Icon="Shop" x:Name="NavBanks" />
                <NavigationViewItem Content="Template Designer" Tag="TemplateDesigner" Icon="Crop" x:Name="NavTemplateDesigner" />
                <NavigationViewItem Content="User Management" Tag="Users" Icon="People" x:Name="NavUsers" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="12,12,12,16">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- User Avatar -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock x:Name="UserAvatarInitial" Text="A" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- User Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock x:Name="UserDisplayNameText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UserRoleTextBlock" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Logout Button -->
                            <Button Grid.Column="2" Content="&#x21AA;" FontSize="16" ToolTipService.ToolTip="Logout" Click="LogoutButton_Click" Background="Transparent" Width="36" Height="36" Padding="0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
        </Grid>
    </Grid>
</Window>
