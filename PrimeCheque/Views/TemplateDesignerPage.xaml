<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PrimeCheque.Views.TemplateDesignerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PrimeCheque.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PrimeCheque.ViewModels"
    xmlns:conv="using:PrimeCheque.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:SelectedToColorConverter x:Key="SelectedToColorConverter" />
        <conv:SelectedToThicknessConverter x:Key="SelectedToThicknessConverter" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <conv:NullToVisibleConverter x:Key="NullToVisibleConverter" />
    </Page.Resources>

    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Visual Canvas Preview -->
        <StackPanel Grid.Column="0" Spacing="16">
            <TextBlock Text="Bank Template Designer" Style="{StaticResource TitleTextBlockStyle}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Select Template to Edit" ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}" DisplayMemberPath="BankName" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="&#x2795; New Template" Command="{x:Bind ViewModel.CreateNewTemplateCommand}" VerticalAlignment="Bottom" />
            </Grid>

            <!-- Visual Cheque Leaf Representation -->
            <Border x:Name="PreviewBorder" SizeChanged="PreviewBorder_SizeChanged" Height="{x:Bind ViewModel.CanvasHeight, Mode=OneWay}" Background="#F8F9FA" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.5" HorizontalAlignment="Stretch">
                <Grid>
                    <!-- Actual cheque background -->
                    <Image Source="{Binding FullImagePath, Mode=OneWay}" Stretch="Fill" Opacity="{x:Bind ViewModel.BackgroundOpacity, Mode=OneWay}" />

                    <!-- User selected overlay reference (e.g. from Scanner) -->
                    <Image Source="{Binding OverlayImagePath, Mode=OneWay}" Stretch="Fill" Opacity="{x:Bind ViewModel.OverlayOpacity, Mode=OneWay}" />

                    <!-- Layer 3: Interactive Designer Fields -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Fields, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas x:Name="ChequeCanvas" Background="Transparent" PointerPressed="ChequeCanvas_PointerPressed" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChequeFieldViewModel">
                                <Canvas>
                                    <!-- Field Border (draggable + shows selection) -->
                                    <Border x:Name="FieldBorder"
                                        Canvas.Left="{x:Bind PxX, Mode=OneWay}" 
                                        Canvas.Top="{x:Bind PxY, Mode=OneWay}" 
                                        Width="{x:Bind PxWidth, Mode=OneWay}" 
                                        Height="{x:Bind PxHeight, Mode=OneWay}"
                                        BorderBrush="{x:Bind IsSelected, Converter={StaticResource SelectedToColorConverter}}" 
                                        Background="#330000FF" 
                                        BorderThickness="{x:Bind IsSelected, Converter={StaticResource SelectedToThicknessConverter}}"
                                        Padding="2"
                                        ManipulationMode="TranslateX,TranslateY"
                                        ManipulationDelta="Field_ManipulationDelta"
                                        PointerPressed="Field_PointerPressed">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="{x:Bind Angle, Mode=OneWay}" CenterX="0" CenterY="0" />
                                        </Border.RenderTransform>

                                        <TextBlock Text="{x:Bind SampleText}" 
                                                   FontSize="{x:Bind FontSize, Mode=OneWay}" 
                                                   FontWeight="{x:Bind FontWeight, Mode=OneWay}" 
                                                   Foreground="Black" 
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Resize Handles (visible only when selected) -->
                                    <Border x:Name="ResizeHandleNE"
                                        Canvas.Left="{x:Bind PxX, Mode=OneWay}" 
                                        Canvas.Top="{x:Bind PxY, Mode=OneWay}" 
                                        Width="8" Height="8"
                                        Background="{x:Bind IsSelected, Converter={StaticResource SelectedToColorConverter}}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"
                                        CornerRadius="2"
                                        ManipulationMode="TranslateX,TranslateY"
                                        ManipulationDelta="ResizeHandle_ManipulationDelta"
                                        Tag="NW"
                                        PointerPressed="Handle_PointerPressed" />
                                    <Border x:Name="ResizeHandleSE"
                                        Canvas.Left="{x:Bind PxXPlusW, Mode=OneWay}" 
                                        Canvas.Top="{x:Bind PxYPlusH, Mode=OneWay}" 
                                        Width="8" Height="8"
                                        Background="{x:Bind IsSelected, Converter={StaticResource SelectedToColorConverter}}"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"
                                        CornerRadius="2"
                                        ManipulationMode="TranslateX,TranslateY"
                                        ManipulationDelta="ResizeHandle_ManipulationDelta"
                                        Tag="SE"
                                        PointerPressed="Handle_PointerPressed" />

                                    <!-- Rotation Handle (visible only when selected) -->
                                    <Ellipse x:Name="RotateHandle"
                                        Canvas.Left="{x:Bind RotateHandleX, Mode=OneWay}" 
                                        Canvas.Top="{x:Bind RotateHandleY, Mode=OneWay}" 
                                        Width="16" Height="16"
                                        Fill="Orange"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}"
                                        Stroke="White" StrokeThickness="2"
                                        ManipulationMode="TranslateX,TranslateY"
                                        ManipulationDelta="RotateHandle_ManipulationDelta"
                                        PointerPressed="Handle_PointerPressed" />

                                    <!-- Rotation line from handle to field top center -->
                                    <Line x:Name="RotateLine"
                                        X1="{x:Bind RotateHandleX, Mode=OneWay}" Y1="{x:Bind RotateHandleY, Mode=OneWay}"
                                        X2="{x:Bind PxCenterX, Mode=OneWay}" Y2="{x:Bind PxY, Mode=OneWay}"
                                        Stroke="Orange" StrokeThickness="2"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Form & Coordinate Controls -->
        <ScrollViewer Grid.Column="1">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Template Details" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBox Header="Bank Name" Text="{x:Bind ViewModel.BankName, Mode=TwoWay}" />
                    <TextBox Header="Series Name" Text="{x:Bind ViewModel.SeriesName, Mode=TwoWay}" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                    <TextBlock Text="Reference Overlay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button Content="Load Overlay (PDF/Image)" Click="LoadOverlay_Click" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Sample Overlay (outPutSamplePdf)" ItemsSource="{x:Bind ViewModel.SampleOverlays, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSampleOverlay, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    <Slider Header="Reference Overlay Opacity" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.OverlayOpacity, Mode=TwoWay}" />
                    <Slider Header="Background Cheque Opacity" Minimum="0" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.BackgroundOpacity, Mode=TwoWay}" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                    <!-- Printer Calibration -->
                    <TextBlock Text="Printer Calibration" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox Header="Printer" ItemsSource="{x:Bind ViewModel.InstalledPrinters, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPrinter, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Select printer..." />
                    <ToggleSwitch Header="Show Calibration Offsets" IsOn="{x:Bind ViewModel.ShowCalibrationOffsets, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ShowCalibrationOffsets, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox Grid.Column="0" Header="H Offset (mm)" Value="{x:Bind ViewModel.CalibrationHOffset, Mode=OneWay}" IsEnabled="False" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" Header="V Offset (mm)" Value="{x:Bind ViewModel.CalibrationVOffset, Mode=OneWay}" IsEnabled="False" SpinButtonPlacementMode="Compact" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                    <!-- Contextual Field Editor -->
                    <TextBlock Text="Selected Field Properties" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid DataContext="{x:Bind ViewModel, Mode=OneWay}">
                        <StackPanel Spacing="8" Visibility="{Binding SelectedField, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}">
                            <TextBlock Text="{Binding SelectedField.DisplayName, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" />
                            
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Header="X (mm)" Value="{Binding SelectedField.X, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                <NumberBox Grid.Column="1" Header="Y (mm)" Value="{Binding SelectedField.Y, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Header="Width (mm)" Value="{Binding SelectedField.Width, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                <NumberBox Grid.Column="1" Header="Height (mm)" Value="{Binding SelectedField.Height, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Grid.Column="0" Header="Angle (°)" Value="{Binding SelectedField.Angle, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                <NumberBox Grid.Column="1" Header="Font Size" Value="{Binding SelectedField.FontSize, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <ComboBox Header="Font Weight" SelectedValue="{Binding SelectedField.FontWeight, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>Normal</x:String>
                                <x:String>Bold</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Select a field on the canvas to edit its properties." 
                               Visibility="{x:Bind ViewModel.SelectedField, Converter={StaticResource NullToVisibleConverter}, Mode=OneWay}" 
                               FontStyle="Italic" Foreground="Gray" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                    <!-- Actions -->
                    <Button Content="&#x1F5A8; Generate Print Preview" Command="{x:Bind ViewModel.GeneratePrintPreviewCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="&#x1F4BE; Save Template" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveTemplateCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="Green" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
